# Copy to .env and edit the values:
#   cp .env.example .env
#
# Compose profiles:
# - core  : web + mysql + freeradius (+ caddy reverse proxy)
# - vpn   : ocserv (host networking)
# - proxy : light-server (host networking)
#
# Tip: you can also set COMPOSE_PROFILES=core,vpn,proxy instead of passing --profile.
# COMPOSE_PROFILES=core

# ----------------------------
# Common / paths
# ----------------------------
TZ=Asia/Shanghai

# Where host bind-mount directories live (defaults to /srv/docker when unset).
DATA_ROOT=/srv/docker

# Some services (freeradius/ocserv/light-server) may only publish amd64 images.
# On arm64 hosts, set this to force emulation:
DOCKER_PLATFORM=linux/amd64

# ----------------------------
# Let's Encrypt via acme.sh (containerized)
# Used by the `acme-sh` service (run it via `docker compose run --rm acme-sh ...`).
# ----------------------------
# Contact email used for ACME account registration / notices
ACME_EMAIL=

# ACME CA: letsencrypt | zerossl | buypass | ...
ACME_CA=letsencrypt

# ----------------------------
# Pebble (ACME test server) ports (testing only)
# ----------------------------
PEBBLE_ACME_PORT=14000
PEBBLE_MGMT_PORT=15000

# ----------------------------
# Web (Flask) service settings
# These variables are consumed by docker-startup.sh to generate config/default.py
# ----------------------------
WEB_PORT=5000

# Flask runtime
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Optional: Flask SERVER_NAME.
# WARNING: if SERVER_NAME is set, Flask will ONLY accept requests whose Host header matches,
# otherwise it returns 404. Behind Caddy, the Host header is usually your public domain.
#
# Leave this EMPTY unless you explicitly need it (e.g., for generating absolute URLs outside a request).
# Example (behind Caddy on :443): SERVER_NAME=internet.zlix.tech
SERVER_NAME=

# Static cache max-age in seconds
SEND_FILE_MAX_AGE_DEFAULT=3600

# ----------------------------
# Web -> MySQL connection (SQLALCHEMY_DATABASE_URI)
# ----------------------------
# When using the local mysql service, keep MYSQL_HOST=mysql
MYSQL_HOST=mysql
MYSQL_DATABASE=radius
MYSQL_USER=radius
MYSQL_PASSWORD=radius
MYSQL_CHARSET=utf8

# ----------------------------
# Local MySQL container (mysql service)
# NOTE: this repo uses mysql:5.7 by default.
# ----------------------------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me

# ----------------------------
# Outbound email (Flask-Mail)
# ----------------------------
MAIL_ENABLE=False
MAIL_SERVER=mail
MAIL_PORT=25
MAIL_TLS_ENABLE=False
MAIL_SSL_ENABLE=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=noreply@vpn.example.org
ADMIN_MAIL=vpn@example.org

# ----------------------------
# Shared RADIUS settings (used by ocserv / light; freeradius uses RADIUS_KEY too)
# ----------------------------
RADIUS_SERVER=127.0.0.1
# NOTE: `RADIUS_KEY` (freeradius side) must match `RADIUS_SECRET` (light/ocserv side).
RADIUS_KEY=change-me
RADIUS_SECRET=change-me

# ----------------------------
# FreeRADIUS container
# ----------------------------
# When running the `core` profile, you can keep this as mysql.
# For an external DB, set FREERADIUS_MYSQL_HOST to that hostname/IP.
FREERADIUS_MYSQL_HOST=mysql
# Some freeradius images require explicit DB user/database parameters.
FREERADIUS_MYSQL_USER=radius
# This is passed through as MYSQL_PASSWORD to the freeradius container.
# In most setups it should match MYSQL_PASSWORD (the DB user password).
# If your freeradius image expects MySQL root, set it to MYSQL_ROOT_PASSWORD instead.
FREERADIUS_MYSQL_PASSWORD=radius

# If you want freeradius to bootstrap its SQL schema (create tables like `nas`),
# provide MySQL admin credentials (typically root). For local dev, this should
# match MYSQL_ROOT_PASSWORD.
FREERADIUS_MYSQL_ADMIN_USERNAME=root
FREERADIUS_MYSQL_ADMIN_PASSWORD=change-me
FREERADIUS_INIT_DATABASE_ENABLE=true

# RADIUS ports published on the control-plane host (freeradius container).
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799

# Traffic quota defaults (bytes). Example: 31457280 = 30 MiB.
DEFAULT_MAX_MONTHLY_TRAFFIC=31457280
ENABLE_DEFAULT_MAX_MONTHLY_TRAFFIC=true

# ----------------------------
# ocserv container
# ----------------------------
OCSERV_DEFAULT_DOMAIN=vpn.example.org
OCSERV_IPV4_NETWORK=192.168.160.0/24
OCSERV_DNS1=1.1.1.1
OCSERV_DNS2=1.0.0.1
OCSERV_TCP_PORT=13806
OCSERV_UDP_PORT=13806

# ----------------------------
# light-server container
# ----------------------------
SQUID_DNS=1.1.1.1



# ----------------------------
# WireGuard
# ----------------------------
WG_SERVER_ENDPOINT=vpn.example.org:51820
WG_SERVER_PRIVATE_KEY=
WG_LISTEN_PORT=51820
WG_SERVER_INTERFACE_IP=10.100.0.1/16
WG_MTU=1420
WG_ADDRESS_POOL=10.100.0.0/16
WG_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
SSE_TOKEN=change-me-token
